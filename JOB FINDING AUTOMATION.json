    {
      "parameters": {
        "jsCode": "const jobs = $input.all().map(item => item.json);\n\nif (jobs.length === 0) {\n  return [{ json: { html: \"<p>No new jobs found.</p>\", count: 0 } }];\n}\n\nlet html = `\n<!DOCTYPE html>\n<html>\n<head>\n<style>\n  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; max-width: 1000px; margin: 0 auto; padding: 20px; background-color: #f5f5f5; }\n  .container { background: white; border-radius: 8px; padding: 30px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }\n  h2 { color: #2c3e50; margin: 0 0 10px 0; }\n  .summary { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; border-radius: 8px; margin-bottom: 25px; }\n  .summary h2 { color: white; }\n  .summary p { margin: 5px 0; opacity: 0.9; }\n  table { width: 100%; border-collapse: collapse; margin-top: 20px; }\n  th, td { padding: 14px; text-align: left; border-bottom: 1px solid #e0e0e0; }\n  th { background-color: #f8f9fa; color: #495057; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; }\n  tr:hover { background-color: #f8f9fa; }\n  td { color: #333; font-size: 14px; }\n  a { color: #667eea; text-decoration: none; font-weight: 600; padding: 6px 12px; background: #f0f3ff; border-radius: 4px; display: inline-block; }\n  a:hover { background: #667eea; color: white; }\n  .source-badge { padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; }\n  .weworkremotely { background: #e3f2fd; color: #1976d2; }\n  .justremote { background: #f3e5f5; color: #7b1fa2; }\n  .himalayas { background: #e8f5e9; color: #388e3c; }\n  .footer { margin-top: 20px; padding-top: 20px; border-top: 1px solid #e0e0e0; color: #9e9e9e; font-size: 12px; text-align: center; }\n</style>\n</head>\n<body>\n<div class=\"container\">\n<div class=\"summary\">\n  <h2>🎯 ${jobs.length} New Remote Job${jobs.length > 1 ? 's' : ''} Found!</h2>\n  <p>📅 ${new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}</p>\n  <p>⏰ ${new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })}</p>\n</div>\n<table>\n  <thead>\n    <tr>\n      <th>Job Title</th>\n      <th>Company</th>\n      <th>Location</th>\n      <th>Source</th>\n      <th>Apply</th>\n    </tr>\n  </thead>\n  <tbody>\n`;\n\njobs.forEach(job => {\n  // Safe handling of potentially undefined fields\n  const jobTitle = job['Job Title'] || 'N/A';\n  const company = job['Company'] || 'N/A';\n  const location = job['Location'] || 'Remote';\n  const source = job['Source'] || 'Unknown';\n  const link = job['Link'] || '#';\n  \n  // Safe toLowerCase with fallback\n  const sourceClass = source ? source.toLowerCase().replace(/\\s/g, '').replace(/\\./g, '') : 'unknown';\n  \n  html += `\n    <tr>\n      <td><strong>${jobTitle}</strong></td>\n      <td>${company}</td>\n      <td>${location}</td>\n      <td><span class=\"source-badge ${sourceClass}\">${source}</span></td>\n      <td><a href=\"${link}\" target=\"_blank\">Apply Now →</a></td>\n    </tr>\n  `;\n});\n\nhtml += `\n  </tbody>\n</table>\n<div class=\"footer\">\n  <p>🤖 Automated by n8n Job Finder | Stay ahead in your job search!</p>\n</div>\n</div>\n</body>\n</html>\n`;\n\nreturn [{ json: { html: html, count: jobs.length } }];\n"
      },
