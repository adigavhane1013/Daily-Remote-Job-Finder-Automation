    {
      "parameters": {
        "jsCode": "const jobs = $input.all().map(item => item.json).filter(job => \n  job['Link'] && \n  job['Link'] !== 'null' && \n  job['Link'] !== 'undefined' &&\n  job['Job Title'] && \n  job['Job Title'] !== 'undefined'\n);\n\nif (jobs.length === 0) {\n  return [{ json: { html: '<p>No new jobs found.</p>', count: 0 } }];\n}\n\nconst badgeColors = {\n  weworkremotely: { bg: '#e3f2fd', color: '#1565c0' },\n  remoteok:       { bg: '#fce4ec', color: '#880e4f' },\n  himalayas:      { bg: '#e8f5e9', color: '#2e7d32' },\n  jobspresso:     { bg: '#fff3e0', color: '#e65100' },\n  workingnomads:  { bg: '#f3e5f5', color: '#6a1b9a' },\n  remotive:       { bg: '#e0f7fa', color: '#00695c' },\n  unknown:        { bg: '#f5f5f5', color: '#616161' }\n};\n\nlet rows = '';\njobs.forEach(job => {\n  const jobTitle = (job['Job Title'] || 'N/A').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n  const company  = (job['Company']   || 'N/A').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n  const location = job['Location'] || 'Remote';\n  const source   = job['Source']   || 'Unknown';\n  const link     = job['Link']     || '#';\n  const key      = source.toLowerCase().replace(/\\s/g, '').replace(/\\./g, '');\n  const badge    = badgeColors[key] || badgeColors['unknown'];\n  rows += `\n    <tr>\n      <td><strong>${jobTitle}</strong></td>\n      <td>${company}</td>\n      <td>${location}</td>\n      <td><span style=\"padding:4px 8px;border-radius:4px;font-size:11px;font-weight:600;background:${badge.bg};color:${badge.color}\">${source}</span></td>\n      <td><a href=\"${link}\" target=\"_blank\" style=\"color:#667eea;text-decoration:none;font-weight:600;padding:6px 12px;background:#f0f3ff;border-radius:4px;display:inline-block\">Apply Now &rarr;</a></td>\n    </tr>`;\n});\n\nconst html = `<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;max-width:1000px;margin:0 auto;padding:20px;background:#f5f5f5}\n  .container{background:#fff;border-radius:8px;padding:30px;box-shadow:0 2px 8px rgba(0,0,0,.1)}\n  .summary{background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);color:#fff;padding:20px;border-radius:8px;margin-bottom:25px}\n  .summary h2{color:#fff;margin:0 0 10px}\n  .summary p{margin:5px 0;opacity:.9}\n  table{width:100%;border-collapse:collapse;margin-top:20px}\n  th,td{padding:14px;text-align:left;border-bottom:1px solid #e0e0e0}\n  th{background:#f8f9fa;color:#495057;font-weight:600;font-size:13px;text-transform:uppercase;letter-spacing:.5px}\n  tr:hover{background:#f8f9fa}\n  td{color:#333;font-size:14px}\n  .footer{margin-top:20px;padding-top:20px;border-top:1px solid #e0e0e0;color:#9e9e9e;font-size:12px;text-align:center}\n</style>\n</head>\n<body>\n<div class=\"container\">\n  <div class=\"summary\">\n    <h2>&#127919; ${jobs.length} New Remote Job${jobs.length > 1 ? 's' : ''} Found!</h2>\n    <p>&#128197; ${new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}</p>\n    <p>&#9200; ${new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })}</p>\n  </div>\n  <table>\n    <thead>\n      <tr><th>Job Title</th><th>Company</th><th>Location</th><th>Source</th><th>Apply</th></tr>\n    </thead>\n    <tbody>\n      ${rows}\n    </tbody>\n  </table>\n  <div class=\"footer\"><p>&#129302; Automated by n8n Remote Job Finder | All jobs stored in MySQL</p></div>\n</div>\n</body>\n</html>`;\n\nreturn [{ json: { html, count: jobs.length } }];"
      },
