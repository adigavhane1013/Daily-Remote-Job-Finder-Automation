    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT IGNORE INTO remote_jobs (date_added, job_title, company, location, source, link, published_date) SELECT '{{ $json[\"Date Added\"] }}', '{{ $json[\"Job Title\"] ? $json[\"Job Title\"].replace(/'/g, \"''\") : '' }}', '{{ $json[\"Company\"] ? $json[\"Company\"].replace(/'/g, \"''\") : \"N/A\" }}', '{{ $json[\"Location\"] || \"Remote\" }}', '{{ $json[\"Source\"] || \"Unknown\" }}', '{{ $json[\"Link\"] }}', '{{ $json[\"Published Date\"] || \"\" }}' WHERE '{{ $json[\"Link\"] }}' != 'null' AND '{{ $json[\"Link\"] }}' != 'undefined' AND '{{ $json[\"Job Title\"] }}' != 'undefined'",
        "options": {}
      },
      "name": "Insert Into MySQL",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [0, 300],
      "id": "1adbf057-ab74-4472-825e-5e1a24b4ee58",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput",
      "credentials": {
        "mySql": {
